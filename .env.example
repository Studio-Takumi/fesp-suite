# ============================================================
# fesp-suite 共通環境変数テンプレート
#   - 各アプリの .env / .dev.vars はこれを元に作成する
#   - 実値はコミットしないこと
# ============================================================

# ---- Supabase (開発用プロジェクト) ----
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
# service_role は Workers のシークレット (wrangler secret) に入れる。フロントには絶対に置かない
SUPABASE_SERVICE_ROLE_KEY=""
# JWT 検証用 JWKS (非対称鍵 / RS256・ES256)
SUPABASE_JWKS_URL="https://xxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_ISSUER="https://xxxxxxxxxxxx.supabase.co/auth/v1"

# ---- API エンドポイント ----
# apps/web (Vite) 用
VITE_API_URL="http://localhost:8787"
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
VITE_PARTYKIT_HOST="127.0.0.1:1999"
# apps/web が表示するイベントの ID（events.id）
VITE_EVENT_ID=""

# apps/lp, apps/admin (Next.js) 用
NEXT_PUBLIC_API_URL="http://localhost:8787"
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
NEXT_PUBLIC_PARTYKIT_HOST="127.0.0.1:1999"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# apps/admin が扱うイベントの ID（events.id）
NEXT_PUBLIC_EVENT_ID=""

# ---- Cloudflare ----
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
R2_BUCKET_NAME="fesp-assets-dev"
