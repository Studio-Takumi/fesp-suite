{
  "name": "@fesp/lp",
  "version": "0.1.0",
  "private": true,
  "description": "LPサイト（サービス紹介）Next.js + Framer Motion",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"(lp) 表示中心のため Playwright のみ: bun run e2e\"",
    "e2e": "playwright test",
    "clean": "rm -rf .turbo .next .open-next playwright-report test-results"
  },
  "dependencies": {
    "@fesp/ui": "workspace:*",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fesp/config": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "wrangler": "^4.131.1"
  }
}
