{
  "name": "@fesp/api",
  "version": "0.1.0",
  "private": true,
  "description": "統合API (Hono on Cloudflare Workers)。3フロント共通のバックエンド",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf .turbo .wrangler dist coverage"
  },
  "dependencies": {
    "@fesp/schema": "workspace:*",
    "@fesp/types": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.116.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@fesp/config": "workspace:*",
    "eslint": "^10.10.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
